TEXT 96 80 Left 3 ;GaN synchronous buck converter -- 100 V DC in, 48.6 V DC out at 4.88 A
TEXT 96 112 Left 1 ;100 V DC supply, with the power loop's own R and L
TEXT 672 424 Left 1 ;HIGH SIDE - control switch
TEXT 600 872 Left 1 ;LOW SIDE - synchronous rectifier
TEXT 776 592 Left 1 ;output filter
TEXT 1040 716 Left 1 ;10 ohm load - 48.6 V, 4.88 A out
TEXT 112 408 Left 1 ;segmented gate driver
TEXT 112 664 Left 1 ;segmented gate driver
TEXT 96 960 Left 2 !.include egan.lib
TEXT 96 984 Left 2 !.include segdrv.lib
TEXT 96 1008 Left 2 !.param VIN=100 D=0.5 FSW=500k
TEXT 96 1032 Left 2 !.param LOUT=22u COUT=4.7u RLOAD=10
TEXT 96 1056 Left 2 !.param VDRV=5 VNEG=-2 CLKEN=1
TEXT 96 1080 Left 2 !.param NPU_LS=8 NPD_LS=8 NPU_HS=8 NPD_HS=8 RUNIT=8
TEXT 96 1104 Left 2 !.param DT=15n TJ=25 LLOOP=3n
TEXT 96 1128 Left 2 !.param KT={1+0.009*(TJ-25)} BH_T={5.55/KT} VTH_T={1.4-0.0015*(TJ-25)}
TEXT 96 1152 Left 2 !.param TSW={1/FSW} TON={D*TSW-DT} TLS={(1-D)*TSW-2*DT} TLSD={D*TSW+DT} TR=0.5n
TEXT 96 1176 Left 2 !.param VO={D*VIN} IO={VO/RLOAD}
TEXT 96 1200 Left 2 !Vpwmhs pwmhs 0 PULSE(0 1 0 {TR} {TR} {TON} {TSW})
TEXT 96 1224 Left 2 !Vpwmls pwmls 0 PULSE(0 1 {TLSD} {TR} {TR} {TLS} {TSW})
TEXT 96 1248 Left 2 !Vlsvp lsvp 0 DC {VDRV}
TEXT 96 1272 Left 2 !Vlsvn lsvn 0 DC {VNEG}
TEXT 96 1296 Left 2 !Blspu lspu 0 V={v(pwmls)}
TEXT 96 1320 Left 2 !Blspd lspd 0 V={1-v(pwmls)}
TEXT 96 1344 Left 2 !Blsclk lsclk 0 V={CLKEN*(1-v(pwmls))}
TEXT 96 1368 Left 2 !Vhsvp hsvp sw DC {VDRV}
TEXT 96 1392 Left 2 !Vhsvn hsvn sw DC {VNEG}
TEXT 96 1416 Left 2 !Bhspu hspu sw V={v(pwmhs)}
TEXT 96 1440 Left 2 !Bhspd hspd sw V={1-v(pwmhs)}
TEXT 96 1464 Left 2 !Bhsclk hsclkl sw V={CLKEN*(1-v(pwmhs))}
TEXT 96 1488 Left 2 !.ic V(out)=0 I(Lo)=0
TEXT 96 1512 Left 2 !.options reltol=1e-3 abstol=1e-10 vntol=1e-6 chgtol=1e-15 gmin=1e-12
TEXT 96 1536 Left 2 !.tran 0.2n 300u 0 2n uic
