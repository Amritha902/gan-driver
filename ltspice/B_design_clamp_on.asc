TEXT 96 48 Left 3 ;B  --  active Miller clamp on, 0 V off-bias.
TEXT 96 80 Left 2 ;Expect vspur = +0.830 V: safe, margin +0.570 V.
TEXT 760 368 Left 2 ;hstop
TEXT 1088 380 Left 2 ;load: 100 uH into VBUS/2
TEXT 96 960 Left 2 !.include egan.lib
TEXT 96 986 Left 2 !.include segdrv.lib
TEXT 96 1012 Left 2 !.param VBUS=100 ILOAD=10 VDRV=5 VNEG=0
TEXT 96 1038 Left 2 !.param CLKEN=1   ; 1 = active Miller clamp enabled
TEXT 96 1064 Left 2 !.param DT=15n CLKDEL=4n RUNIT=8 TJ=25
TEXT 96 1090 Left 2 !.param LLOOP=3n LLOAD=100u TR=0.1n
TEXT 96 1116 Left 2 !.param KT={1+0.009*(TJ-25)} BH_T={5.55/KT} VTH_T={1.4-0.0015*(TJ-25)}
TEXT 96 1142 Left 2 !.param VOUT={VBUS/2}
TEXT 96 1168 Left 2 !.param T1=1u T2={T1+DT} T3=2u T4={T3+DT}
TEXT 96 1194 Left 2 !Vshs hstop hsd DC 0
TEXT 96 1220 Left 2 !Vsls sw lsd DC 0
TEXT 96 1246 Left 2 !Vpwmls pwmls 0 PWL(0 1 {T1} 1 {T1+TR} 0 {T4} 0 {T4+TR} 1)
TEXT 96 1272 Left 2 !Vpwmhs pwmhs 0 PWL(0 0 {T2} 0 {T2+TR} 1 {T3} 1 {T3+TR} 0)
TEXT 96 1298 Left 2 !Vclkls lsclk 0 PWL(0 0 {T1+CLKDEL} 0 {T1+CLKDEL+TR} {CLKEN} {T4} {CLKEN} {T4+TR} 0)
TEXT 96 1324 Left 2 !Vclkhs clkhs 0 PWL(0 {CLKEN} {T2} {CLKEN} {T2+TR} 0 {T3+CLKDEL} 0 {T3+CLKDEL+TR} {CLKEN})
TEXT 96 1350 Left 2 !Blspu lspu 0 V={v(pwmls)}
TEXT 96 1376 Left 2 !Blspd lspd 0 V={1-v(pwmls)}
TEXT 96 1402 Left 2 !Bhspu hspu sw V={v(pwmhs)}
TEXT 96 1428 Left 2 !Bhspd hspd sw V={1-v(pwmhs)}
TEXT 96 1454 Left 2 !Bhsclk hsclkl sw V={v(clkhs)}
TEXT 96 1480 Left 2 !.options reltol=1e-3 abstol=1e-10 vntol=1e-6 chgtol=1e-15 gmin=1e-12
TEXT 96 1506 Left 2 !.ic v(sw)=0 v(lsg)={VDRV} v(hsg)={VNEG} v(out)={VOUT}
TEXT 96 1532 Left 2 !.tran 0.02n 3u 0 0.02n uic
TEXT 96 1558 Left 2 !.meas TRAN vspur MAX V(hsg,sw) FROM 2.015u TO 2.1u
TEXT 96 1600 Left 2 ;Press Run, then View > SPICE Error Log for vspur. Probe V(hsg,sw): the gate of the device that is OFF.
