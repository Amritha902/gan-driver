Version 4
SHEET 1 2200 1600
TEXT 64 48 Left 4 ;GaN half-bridge double-pulse test  --  C -- clamp on and -2 V off-bias.  EXPECT vspur = -1.176 V: safe, margin +2.576 V.
TEXT 64 128 Left 2 ;HOW TO RUN THIS\n  1. Press Run (the running-man button, or Simulate > Run).\n  2. View > SPICE Error Log  --  the last line is the measurement:\n         vspur: MAX(v(hsg,sw)) ...\n  3. vspur is the voltage on the gate of the device that is supposed\n     to be OFF. The device turns on above 1.4 V.\n\n  Keep this file in the same folder as egan.lib and segdrv.lib.
TEXT 64 400 Left 2 !.include egan.lib\n.include segdrv.lib\n.param VBUS=100\n.param ILOAD=10\n.param VDRV=5\n.param VNEG=-2\n.param NPU_LS=8\n.param NPD_LS=8\n.param NPU_HS=8\n.param NPD_HS=8\n.param DT=15n\n.param CLKEN=1\n.param CLKDEL=4n\n.param RUNIT=8\n.param TJ=25\n.param KT   = {1 + 0.009*(TJ-25)}\n.param BH_T = {5.55/KT}\n.param VTH_T= {1.4 - 0.0015*(TJ-25)}\n.param VOUT  = {VBUS/2}\n.param LLOOP = 3n\n.param LLOAD = 100u\n.param TR    = 0.1n\n.param T1 = 1u\n.param T2 = {T1+DT}\n.param T3 = 2u\n.param T4 = {T3+DT}\n.param TSTOP = 3u\nVbus   bus 0 DC {VBUS}\nRloop  bus n1  0.3                    ; loop R including skin effect at ~300 MHz.\nLloop  n1  hstop {LLOOP}\nVshs   hstop hsd DC 0                 ; HS drain current sense\nXhs    hsd hsg sw EGAN params: vth={VTH_T} bh={BH_T}\nVsls   sw  lsd DC 0                   ; LS drain current sense\nXls    lsd lsg 0  EGAN params: vth={VTH_T} bh={BH_T}\nLload  out sw {LLOAD} IC={ILOAD}\nVout   out 0 DC {VOUT}\nVpwmls pwmls 0 PWL(0 1 {T1} 1 {T1+TR} 0 {T4} 0 {T4+TR} 1)\nVpwmhs pwmhs 0 PWL(0 0 {T2} 0 {T2+TR} 1 {T3} 1 {T3+TR} 0)\nVclkls lsclk 0 PWL(0 0 {T1+CLKDEL} 0 {T1+CLKDEL+TR} {CLKEN} {T4} {CLKEN} {T4+TR} 0)\nVclkhs clkhs 0 PWL(0 {CLKEN} {T2} {CLKEN} {T2+TR} 0 {T3+CLKDEL} 0 {T3+CLKDEL+TR} {CLKEN})\nVlsvp  lsvp 0 DC {VDRV}\nVlsvn  lsvn 0 DC {VNEG}\nBlspu  lspu 0 V = {v(pwmls)}\nBlspd  lspd 0 V = {1-v(pwmls)}\nXdrvls lspu lspd lsclk lsg lsvp lsvn 0 SEGDRV\n+      params: npu={NPU_LS} npd={NPD_LS} runit={RUNIT} rclamp=0.5\nVhsvp  hsvp sw DC {VDRV}\nVhsvn  hsvn sw DC {VNEG}\nBhspu  hspu sw V = {v(pwmhs)}\nBhspd  hspd sw V = {1-v(pwmhs)}\nBhsclk hsclkl sw V = {v(clkhs)}\nXdrvhs hspu hspd hsclkl hsg hsvp hsvn sw SEGDRV\n+      params: npu={NPU_HS} npd={NPD_HS} runit={RUNIT} rclamp=0.5\n.options reltol=1e-3 abstol=1e-10 vntol=1e-6 chgtol=1e-15 gmin=1e-12\n.ic v(sw)=0 v(lsg)={VDRV} v(hsg)={VNEG} v(out)={VOUT}\n.tran 0.02n {TSTOP} 0 0.05n uic\n.save v(sw) v(lsg) v(hsg) v(lsd) v(hsd)\n+ i(vsls) i(vshs)\n.meas TRAN vspur MAX V(hsg,sw) FROM 2.015u TO 2.10u
