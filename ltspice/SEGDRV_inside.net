Rpd2 out N010 {runit + (npd>=2 ? 0 : 1e9)}
Spd2 N010 vn pd 0 SWP
Rpd3 out N011 {runit + (npd>=3 ? 0 : 1e9)}
Spd3 N011 vn pd 0 SWP
Rpd4 out N012 {runit + (npd>=4 ? 0 : 1e9)}
