        </mxCell>
        <mxCell id="pow-45" value="Rdec is a damping value. At 20 mOhm this branch rings near 22 MHz and drove the low-side gate to +11.8 V against a 1.4 V threshold at a 200 V bus." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="pow-1">
