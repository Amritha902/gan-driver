        </mxCell>
        <mxCell id="seg-96" value="Ask for three or more slices and Rpu3 is 8 ohm, in circuit; ask for fewer and it becomes 1 Gohm - that slice switched out. Drive strength is how many of the 8 parallel paths are live." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="seg-1">
          <mxGeometry x="60" y="778" width="1400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="seg-97" value="The clamp is worth +0.82 V of crosstalk margin and the -2 V rail a further +2.01 V. The 8 slices - the part everyone builds - cost 0.00 % to freeze." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="seg-1">
